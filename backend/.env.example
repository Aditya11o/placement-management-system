# =============================================
# PMS Backend - Environment Variables Template
# =============================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# IMPORTANT: NEVER commit the actual .env file to git!
# =============================================

# Server
# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/pms

# Authentication (Generate strong random strings)
JWT_SECRET=your_jwt_access_secret_here
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=1h
JWT_COOKIE_EXPIRES_IN=7

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM="Placement Cell" <your_email@gmail.com>

# Asset Storage (Cloudinary)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Security
CORS_ORIGIN=http://localhost:5173
XSS_PROTECTION=true
CRAWL_DELAY=100

# Development Only — OTP Bypass (leave blank in production!)
# TEST_OTP_BYPASS_EMAIL=hr@tcs.com
