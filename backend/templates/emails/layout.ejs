<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= subject %></title>
  <style>
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      line-height: 1.6;
      color: #334155;
      margin: 0;
      padding: 0;
      background-color: #f8fafc;
    }
    .wrapper {
      max-width: 600px;
      margin: 40px auto;
      background: #ffffff;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
      border: 1px solid #e2e8f0;
    }
    .header {
      background: #000613;
      padding: 40px 20px;
      text-align: center;
      color: #ffffff;
    }
    .header h1 {
      margin: 0;
      font-size: 24px;
      font-weight: 900;
      letter-spacing: -0.025em;
      text-transform: uppercase;
      font-style: italic;
    }
    .header p {
      margin: 8px 0 0;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      opacity: 0.6;
    }
    .content {
      padding: 48px;
    }
    .footer {
      padding: 32px 48px;
      background-color: #f1f5f9;
      text-align: center;
      border-top: 1px solid #e2e8f0;
    }
    .footer p {
      margin: 0;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #94a3b8;
    }
    .btn {
      display: inline-block;
      padding: 14px 28px;
      background-color: #000613;
      color: #ffffff !important;
      text-decoration: none;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin: 24px 0;
      transition: all 0.3s;
    }
    .otp-code {
      font-size: 32px;
      font-weight: 900;
      letter-spacing: 0.2em;
      color: #2563eb;
      margin: 24px 0;
      background: #eff6ff;
      padding: 16px;
      border-radius: 16px;
      display: inline-block;
      border: 1px dashed #bfdbfe;
    }
    h2 {
      font-size: 20px;
      font-weight: 800;
      color: #0f172a;
      margin-top: 0;
      letter-spacing: -0.01em;
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      <h1>Placement <span style="color: #60a5fa;">Cell</span></h1>
      <p>Strategic Career Management Portal</p>
    </div>
    <div class="content">
      <%- body %>
    </div>
    <div class="footer">
      <p>&copy; <%= new Date().getFullYear() %> Placement Management System (PMS)</p>
      <p style="margin-top: 8px;">Academic Authority & Excellence Guaranteed</p>
    </div>
  </div>
</body>
</html>
