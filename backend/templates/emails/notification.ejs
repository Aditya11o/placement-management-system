<h2><%= title %></h2>
<p>Hello <%= name %>,</p>
<div style="background: #f8fafc; border-left: 4px solid #000613; padding: 24px; border-radius: 0 16px 16px 0; margin: 32px 0;">
  <p style="margin: 0; font-size: 14px; line-height: 1.8; color: #334155;">
    <%- message %>
  </p>
</div>
<% if (actionUrl) { %>
  <div style="text-align: center; margin: 32px 0;">
    <a href="<%= actionUrl %>" class="btn"><%= actionText || 'View Details' %></a>
  </div>
<% } %>
<p style="font-size: 11px; font-weight: 600; color: #94a3b8; text-align: center; margin-top: 32px;">
  Placement Management System (PMS)
</p>
