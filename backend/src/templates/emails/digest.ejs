<h2>Daily Updates Summary</h2>
<p>Hello <%= name %>,</p>
<p>You have <strong><%= count %></strong> new updates from the last 24 hours:</p>

<div style="margin: 20px 0; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
    <% notifications.forEach(function(item, index) { %>
        <div style="padding: 15px; border-bottom: <%= index === notifications.length - 1 ? 'none' : '1px solid #e2e8f0' %>; background-color: #f8fafc;">
            <div style="font-weight: bold; color: #1e293b; margin-bottom: 4px;"><%= item.title %></div>
            <div style="font-size: 14px; color: #64748b; margin-bottom: 4px;"><%= item.message %></div>
            <div style="font-size: 12px; color: #94a3b8;"><%= item.time %></div>
        </div>
    <% }); %>
</div>

<% if (typeof cta !== 'undefined' && cta.url) { %>
    <table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin-top: 20px;">
        <tr>
            <td align="center">
                <table border="0" cellspacing="0" cellpadding="0">
                    <tr>
                        <td align="center" style="border-radius: 6px;" bgcolor="#2563eb">
                            <a href="<%= cta.url %>" target="_blank" class="button" style="padding: 12px 24px; color: #ffffff; text-decoration: none; display: inline-block; font-weight: bold;"><%= cta.text %></a>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
<% } %>

<p style="margin-top: 30px;">Best regards,<br>The Placement Cell Team</p>
