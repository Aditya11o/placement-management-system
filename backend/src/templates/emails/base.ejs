<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body { margin: 0; padding: 0; font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif; background-color: #f4f7f6; color: #333333; }
        .wrapper { width: 100%; table-layout: fixed; background-color: #f4f7f6; padding-bottom: 40px; }
        .main { background-color: #ffffff; margin: 0 auto; width: 100%; max-width: 600px; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05); }
        .header { background-color: #0f172a; padding: 24px; text-align: center; }
        .header h1 { color: #ffffff; margin: 0; font-size: 24px; font-weight: 600; letter-spacing: -0.5px; }
        .content { padding: 32px 40px; }
        .content h2 { font-size: 20px; color: #0f172a; margin-top: 0; margin-bottom: 16px; }
        .content p { font-size: 16px; line-height: 1.6; margin: 0 0 16px 0; color: #475569; }
        .button { display: inline-block; padding: 12px 24px; background-color: #2563eb; color: #ffffff !important; text-decoration: none; border-radius: 6px; font-weight: 500; margin-top: 16px; margin-bottom: 16px; }
        .footer { background-color: #f8fafc; padding: 24px; text-align: center; border-top: 1px solid #e2e8f0; }
        .footer p { margin: 0; font-size: 13px; color: #64748b; }
        .highlight { background-color: #f1f5f9; padding: 12px; border-radius: 4px; font-family: monospace; font-size: 18px; letter-spacing: 2px; text-align: center; display: block; margin: 16px 0; font-weight: 600;}
        .table-data { width: 100%; border-collapse: collapse; margin-top: 16px; margin-bottom: 16px; }
        .table-data th, .table-data td { padding: 12px; text-align: left; border-bottom: 1px solid #e2e8f0; }
        .table-data th { background-color: #f8fafc; font-weight: 600; color: #475569; font-size: 14px; }
        .table-data td { font-size: 14px; color: #333333; }
        
        @media screen and (max-width: 600px) {
            .content { padding: 24px 20px; }
        }
    </style>
</head>
<body>
    <center class="wrapper">
        <table class="main" width="100%">
            <!-- Header section -->
            <tr>
                <td class="header">
                    <h1>Placement Management System</h1>
                </td>
            </tr>

            <!-- Content section injected from inner templates -->
            <tr>
                <td class="content">
                    <%- body %>
                </td>
            </tr>

            <!-- Footer section -->
            <tr>
                <td class="footer">
                    <p>&copy; <%= new Date().getFullYear() %> University Placement Cell. All rights reserved.</p>
                    <p style="margin-top: 8px;">Please do not reply directly to this automated email.</p>
                </td>
            </tr>
        </table>
    </center>
</body>
</html>
